{
  "name": "snap-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:security": "node --import tsx scripts/security-smoke.mts",
    "db:create": "wrangler d1 create snap-hub-db --binding DB --update-config --config wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.json --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.json",
    "deploy:check": "npm run build && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "4.0.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5",
    "fast-uri": "3.1.9",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "source-map-js": "1.2.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
